# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://rxpos:your_password@localhost:5432/rxpos

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Random secret for signing JWTs — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-generate-a-random-32-char-string

# ─── Redis ────────────────────────────────────────────────────────────────────
# Used for token blacklisting, session management, rate limiting, Celery broker
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Docker ───────────────────────────────────────────────────────────────────
DB_PASSWORD=rxpos_dev_password

# ─── Email (SendGrid) ─────────────────────────────────────────────────────────
# Sign up at https://sendgrid.com — free tier supports 100 emails/day
# Used for: password reset emails, daily summary reports, prescription notifications
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── SMS / WhatsApp (Twilio) ──────────────────────────────────────────────────
# Sign up at https://twilio.com — used for SMS OTPs and WhatsApp prescription alerts
# Get credentials at https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ─── Drug Database (OpenFDA) ──────────────────────────────────────────────────
# Optional — improves medicine enrichment (interaction checks, NDC lookups)
# Free API key at https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=your_openfda_api_key

# ─── Drug Database (DrugBank) ─────────────────────────────────────────────────
# Commercial — required for comprehensive drug-drug interaction checking
# Apply at https://go.drugbank.com/releases/latest#swagger
DRUGBANK_API_KEY=your_drugbank_api_key

# ─── AWS (Optional — for S3 prescription image storage) ──────────────────────
# Create an IAM user with s3:PutObject permission on your bucket
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=us-east-1
AWS_S3_BUCKET=rxpos-prescriptions

# ─── Google Vision (Optional — for prescription OCR) ──────────────────────────
# Create a service account at https://console.cloud.google.com/
# Enable the Vision API and download the JSON key, then paste it (JSON on one line) below
GOOGLE_VISION_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
